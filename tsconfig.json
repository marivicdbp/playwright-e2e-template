{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@playwright-setup": ["libs/playwright-setup.ts"],
      "@config-interface": ["libs/config-interface.ts"],
      "@common": ["libs/page-helpers/common.ts"],
      "@accessibility": ["libs/page-helpers/accessibility.ts"],
      "@google/*": ["packages/google/*"]
    }
  },
  "exclude": ["node_modules"]
}
